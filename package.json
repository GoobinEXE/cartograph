{
  "name": "cartograph",
  "version": "2.1.0",
  "private": true,
  "description": "Cartograph — Scientific Metasearch & Literature Discovery Hub (Cross-Platform Windows, Linux, macOS)",
  "type": "module",
  "scripts": {
    "dev": "node server/launcher-bridge.mjs --with-vite",
    "start": "node server/launcher-bridge.mjs --with-vite --open",
    "vite": "vite --port 5173",
    "bridge": "node server/launcher-bridge.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
